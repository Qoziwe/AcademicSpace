{
  "name": "academicspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["frontend"],
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx,js,jsx}": [
      "npm exec --workspace frontend -- eslint --fix --max-warnings=0",
      "npm exec --workspace frontend -- prettier --write"
    ],
    "frontend/**/*.{json,md,yml,yaml}": ["npm exec --workspace frontend -- prettier --write"],
    "backend/**/*.py": [
      "uv run --project backend ruff check --fix --force-exclude",
      "uv run --project backend black --force-exclude"
    ]
  }
}
