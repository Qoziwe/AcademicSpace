FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

# Не задан — по умолчанию локальный SQLite-файл (instance/dev.db), без
# Docker/Postgres. Раскомментируй для Postgres (Docker Compose ставит это
# сам через environment: в docker-compose.yml) или для прод-паритета:
# DATABASE_URL=postgresql+psycopg://academicspace:academicspace@localhost:5432/academicspace

CORS_ORIGINS=http://localhost:8081

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=storage

# Какой ИИ-провайдер обслуживает какую фичу — не хардкод, конфигурируется здесь.
# anthropic | openai | openrouter (один ключ, доступ к моделям разных вендоров
# через OpenAI-совместимый API — модель задаётся OPENROUTER_MODEL ниже)
AI_CHAT_PROVIDER=anthropic
AI_PORTFOLIO_PROVIDER=anthropic
AI_FLASHCARDS_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Нужен только если AI_*_PROVIDER=openrouter где-то выше. MODEL — слаг вида
# "провайдер/модель" из https://openrouter.ai/models, например
# anthropic/claude-sonnet-4.5 или openai/gpt-4o — без дефолта, задать явно.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Платёжный провайдер для POST /subscription/subscribe. Реальный провайдер
# для Кыргызстана ещё не выбран (docs/00-roadmap.md Фаза 8.7) — "mock"
# честно активирует Premium без реального списания денег.
PAYMENT_PROVIDER=mock
