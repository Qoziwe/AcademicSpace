# AcademicSpace — пример переменных окружения.
# Скопировать в `.env` (в .gitignore). Секреты сюда НЕ коммитим.
# Всё публичное — только с префиксом EXPO_PUBLIC_ (CLAUDE.md §5).

# Базовый URL Flask-бекенда (см. backend/README.md).
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Мок-слой. true — все данные из frontend/mocks/*. false — реальный бекенд
# (Auth, Profile, Questionnaire, Universities, Tasks, Vaults, Subscription,
# Achievement Log, AI Mentor, Flashcards — Фазы 8.3–8.5; загрузка файла в
# ячейку копилки всё ещё notImplemented(), см. Фазу 8.6).
EXPO_PUBLIC_USE_MOCKS=true
